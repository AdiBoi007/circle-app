# For running the API directly with Node, without Docker Compose.
# Replace REPLACE_WITH_DATABASE_PASSWORD and provide your own random AUTH_SECRET.
DATABASE_URL=postgresql://circle:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/circle
AUTH_SECRET=

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
API_URL=http://localhost:8787
APP_URL=http://localhost:8081

# Tests must use a separate disposable database, never the application database.
# Set NODE_ENV=test when running integration tests.
TEST_DATABASE_URL=postgresql://circle:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/circle_test

# No email is sent until transport, provider key and sender are configured.
MAIL_TRANSPORT=disabled
RESEND_API_KEY=
MAIL_FROM=
