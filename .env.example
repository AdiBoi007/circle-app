# Expo reads only EXPO_PUBLIC_* values into the client bundle. They are public.
EXPO_PUBLIC_APP_MODE=live
EXPO_PUBLIC_API_URL=http://localhost:8787

# Local Docker Compose configuration. Fill these two values before starting.
# Generate separate 32-byte hexadecimal values; do not commit the resulting .env.
AUTH_SECRET=
DATABASE_PASSWORD=

# Browser-facing origins, without /api or a trailing slash.
API_URL=http://localhost:8787
APP_URL=http://localhost:8081

# Disabled is intentional for local testing. It does not deliver mail.
MAIL_TRANSPORT=disabled
RESEND_API_KEY=
MAIL_FROM=
